#!/bin/bash
set -Eeuo pipefail

exec > >(tee /var/log/homefit-bootstrap.log | logger -t homefit-bootstrap -s 2>/dev/console) 2>&1

dnf install -y docker jq
command -v aws >/dev/null 2>&1 || dnf install -y awscli2
systemctl enable --now docker

install -d -m 700 /etc/homefit

APP_ENV="$(aws secretsmanager get-secret-value \
  --region '${aws_region}' \
  --secret-id '${app_secret_arn}' \
  --query SecretString \
  --output text)"

printf '%s\n' "$${APP_ENV}" > /etc/homefit/backend.env
chmod 600 /etc/homefit/backend.env

DB_SECRET="$(aws secretsmanager get-secret-value \
  --region '${aws_region}' \
  --secret-id '${database_secret_arn}' \
  --query SecretString \
  --output text)"

DB_USERNAME="$(printf '%s' "$${DB_SECRET}" | jq -r '.username')"
DB_PASSWORD="$(printf '%s' "$${DB_SECRET}" | jq -r '.password')"
DB_USERNAME_ENCODED="$(printf '%s' "$${DB_USERNAME}" | jq -sRr @uri)"
DB_PASSWORD_ENCODED="$(printf '%s' "$${DB_PASSWORD}" | jq -sRr @uri)"
DATABASE_URL="postgresql://$${DB_USERNAME_ENCODED}:$${DB_PASSWORD_ENCODED}@${database_host}:${database_port}/${database_name}?schema=public&sslmode=require"

printf 'DATABASE_URL=%s\n' "$${DATABASE_URL}" >> /etc/homefit/backend.env

aws ecr get-login-password --region '${aws_region}' \
  | docker login --username AWS --password-stdin '${ecr_registry}'

docker pull '${image_uri}'

docker run --rm \
  --env-file /etc/homefit/backend.env \
  '${image_uri}' \
  npm run prisma:migrate:deploy

docker rm -f homefit-backend 2>/dev/null || true

docker run -d \
  --name homefit-backend \
  --restart unless-stopped \
  --env-file /etc/homefit/backend.env \
  --publish '${app_port}:${app_port}' \
  --log-driver awslogs \
  --log-opt awslogs-region='${aws_region}' \
  --log-opt awslogs-group='${log_group_name}' \
  --log-opt awslogs-create-group=false \
  '${image_uri}'
